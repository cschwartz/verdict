set fallback
set dotenv-load

# List available recipes
default:
    @just --list


# Run tests (excludes e2e; use test-e2e for those)
test *ARGS:
    DATABASE_NAME=$DATABASE_NAME_TEST uv run pytest --disable-plugin-autoload -p asyncio -m "not e2e" {{ARGS}}

# Run end-to-end tests (requires services to be running)
test-e2e *ARGS:
    DATABASE_NAME=$DATABASE_NAME_TEST uv run pytest --disable-plugin-autoload -p asyncio -m e2e {{ARGS}}

# Run tests with coverage
test-cov *ARGS:
    DATABASE_NAME=$DATABASE_NAME_TEST uv run pytest --disable-plugin-autoload -p asyncio -p pytest_cov --cov=app --cov-report=html --cov-report=term-missing {{ARGS}}

# Format code
format:
    uv run ruff format .

# Lint code
lint:
    uv run ruff check . --fix

# Type check
type-check:
    uv run mypy app
    uv run pyright app tests

# Run all code quality checks
check: format lint type-check

# Run database migrations
db-migrate:
    uv run alembic upgrade head

# Create a new migration (usage: just db-migrate-create "my migration")
db-migrate-create message:
    uv run alembic revision --autogenerate -m "{{message}}"

# Reset the development database
db-reset:
    #!/usr/bin/env bash
    echo "Resetting database..."
    dropdb --if-exists "$DATABASE_NAME"
    createdb "$DATABASE_NAME"
    echo "Database reset complete. Run 'just db-migrate' to apply migrations."

# Reset the test database
db-test-reset:
    #!/usr/bin/env bash
    echo "Resetting test database..."
    dropdb --if-exists "$DATABASE_NAME_TEST"
    createdb "$DATABASE_NAME_TEST"
    echo "Test database reset complete."

# Open database shell (pgcli)
db-shell:
    pgcli

# Regenerate JSON Schema for config/roles/*.yaml from the RoleConfig pydantic model
gen-config-schema:
    uv run python -c "from app.schemas.config import RoleConfig; import json; print(json.dumps(RoleConfig.model_json_schema(), indent=2))" > ../config/roles/schema.json.tmp && mv ../config/roles/schema.json.tmp ../config/roles/schema.json

# Create a local user (--role flags are optional and repeatable)
create-user username email *ROLES:
    uv run python -m app.cli --username {{username}} --email {{email}} {{ROLES}}
